  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start:worker": "nodemon --ext ts,json --ignore client.ts --ignore server.ts --ignore public --exec \"ts-node -T worker.ts\"",
    "start:client": "nodemon --watch client.ts --exec \"ts-node -T client.ts\"",
    "start:server": "nodemon --ext ts,json --ignore client.ts --ignore worker.ts --ignore public --exec \"ts-node -T server.ts\"",
    "typecheck": "tsc --noEmit",
    "start": "ts-node -T server.ts",
    "start:worker:prod": "ts-node -T worker.ts",
    "start:all": "ts-node -T all.ts"
  },
  "dependencies": {
    "@temporalio/activity": "^1.13.0",
    "@temporalio/client": "^1.13.0",
    "@temporalio/common": "^1.13.0",
    "@temporalio/worker": "^1.13.0",
    "@temporalio/workflow": "^1.13.0",
    "axios": "^1.12.2",
    "convert-csv-to-json": "^3.28.0",
    "express": "^4.22.2",
    "moment": "^2.30.1",
    "nodemon": "^3.1.14",
    "pg": "^8.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.6.1",
    "@types/pg": "^8.20.0"
  },
  "engines": {
    "node": ">=20"
  }
}
